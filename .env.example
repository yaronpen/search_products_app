# Copy to .env and fill in. Never commit .env.
APP_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_NAME=catalog
DB_USER=catalog
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Embeddings for semantic search. Without it the app falls back to keyword-only search.
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
# Changing the model or dimensions requires re-running the import (it re-embeds everything automatically)
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
OPENAI_EMBEDDINGS_DIMENSIONS=512
# Max wait for the query embedding during a search; on timeout the search falls back to keywords only
OPENAI_WEB_TIMEOUT_SECONDS=3
